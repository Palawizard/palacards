# Copier en .env à la racine (jamais commité)

# --- Base de données ---
POSTGRES_USER=palacards
POSTGRES_PASSWORD=change-me
POSTGRES_DB=palacards
# Port hôte du Postgres de dev (5433 pour ne pas entrer en conflit avec un Postgres déjà installé)
POSTGRES_PORT=5433
DATABASE_URL=postgres://palacards:change-me@localhost:5433/palacards

# --- API ---
API_HOST=0.0.0.0
API_PORT=4000
# Sous-chemin public (www.palawi.fr/palacards/)
BASE_PATH=/palacards
# Origine autorisée pour CORS / Socket.IO (front en dev)
WEB_ORIGIN=http://localhost:3000

# --- Auth (Better Auth) ---
# Secret de signature des sessions (32 caractères min.) : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=change-me-change-me-change-me-change-me
# Origine publique de l'API, sans chemin (prod : https://www.palawi.fr)
BETTER_AUTH_URL=http://localhost:4000
# Pseudos admin, séparés par des virgules
ADMIN_USERNAMES=palawi
# Derrière Caddy + Cloudflare (prod) : 1 pour lire l'IP réelle dans les en-têtes
TRUST_PROXY=0
# Niveau de logs de l'API (trace, debug, info, warn, error)
LOG_LEVEL=info
# Tests uniquement (jamais en prod, l'API refuse de démarrer) : routes /api/test/* et Wikimedia coupé
# GAME_TEST_MODE=0
# WIKIMEDIA_DISABLED=0

# --- Front ---
# URL de l'API vue depuis le navigateur (en prod : même origine, donc vide)
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Wikimedia ---
# Contact obligatoire dans le User-Agent (politique Wikimedia)
WIKIMEDIA_USER_AGENT=PalaCards/0.1 (https://www.palawi.fr/palacards/; ton-email@exemple.fr)

# --- Production (vm-apps) : valeurs à adapter dans /opt/dockpanel/stacks/palacards/.env ---
# POSTGRES_PASSWORD=<long mot de passe aléatoire>
# DATABASE_URL est fixé par docker-compose.yml (hôte « postgres » du réseau interne)
# BETTER_AUTH_SECRET=<32+ caractères aléatoires>
# BETTER_AUTH_URL=https://www.palawi.fr
# WEB_ORIGIN=https://www.palawi.fr
# NEXT_PUBLIC_API_URL=     (vide : même origine, lu au build de l'image web)
# TRUST_PROXY=1

