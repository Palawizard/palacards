{
  "name": "palacards",
  "private": true,
  "description": "PalaCards — jeu de cartes à collectionner basé sur les articles du Wikipédia FR",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "predev": "pnpm --filter \"./packages/*\" build",
    "dev": "pnpm --parallel --filter @palacards/api --filter @palacards/web dev",
    "dev:api": "pnpm --filter @palacards/api dev",
    "dev:web": "pnpm --filter @palacards/web dev",
    "build": "pnpm -r build",
    "pretypecheck": "pnpm --filter \"./packages/*\" build",
    "typecheck": "pnpm -r typecheck",
    "pretest": "pnpm --filter \"./packages/*\" build",
    "test": "pnpm -r test",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:generate": "pnpm --filter @palacards/db generate",
    "db:migrate": "pnpm --filter @palacards/db migrate",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:seed": "pnpm --filter @palacards/db seed",
    "e2e": "pnpm --filter @palacards/e2e e2e",
    "bench": "pnpm --filter \"./packages/*\" build && pnpm --filter @palacards/api bench"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  }
}
